# LLM Gateway — Docker environment (template)
# Copy to docker/.env (or project-root .env) and fill in. NEVER commit real values.
# The setup wizard (python wizard/setup.py) generates this file with random secrets.

# ---- Required ----
# Postgres password used by docker-compose services (generate: python -c "import secrets; print(secrets.token_urlsafe(16))")
POSTGRES_PASSWORD=

# ---- Security ----
# LiteLLM master key — random, >= 32 chars (generate: sk-litellm-$(python -c "import secrets; print(secrets.token_urlsafe(32))"))
LITELLM_MASTER_KEY=
# Web UI session signing secret — set a fixed value so sessions survive restarts
SESSION_SECRET=
# Fernet key for encrypting provider API keys at rest (P1.2.1). Generate:
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_ENCRYPTION_KEY=

# ---- Cloud provider API keys (free tiers) ----
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
