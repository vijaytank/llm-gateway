# docker/Dockerfile.adapter — Anthropic inbound adapter (FastAPI, port 4001)
#
# Build context is the PROJECT ROOT (compose sets context: ..), so paths
# here are project-root relative.
#
# Review F-M13: pins below MUST match requirements.txt exactly. The full
# requirements file is intentionally not installed here to keep this image
# slim (no litellm/brain/UI deps are needed by the adapter).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt ./
# Extract the shared pins from the single source of truth so they can't drift.
RUN pip install --no-cache-dir \
    fastapi==$(grep -E '^fastapi==' requirements.txt | cut -d= -f3) \
    "uvicorn[standard]==$(grep -E '^uvicorn' requirements.txt | cut -d= -f3)" \
    pydantic==$(grep -E '^pydantic==' requirements.txt | cut -d= -f3) \
    httpx==$(grep -E '^httpx==' requirements.txt | cut -d= -f3) \
    python-dotenv==$(grep -E '^python-dotenv==' requirements.txt | cut -d= -f3)

COPY adapter/ ./adapter/
COPY schemas/ ./schemas/

ENV PYTHONUNBUFFERED=1
EXPOSE 4001

CMD ["uvicorn", "adapter.server:app", "--host", "0.0.0.0", "--port", "4001"]
