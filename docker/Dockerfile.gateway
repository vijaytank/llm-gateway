# docker/Dockerfile.gateway — LiteLLM proxy + routing brain + UI (supervisord)
#
# Per Issue 9: gateway (LiteLLM) and brain run as two processes in ONE
# container, managed by supervisord. Brain crash never kills the proxy.
# The same image also serves the web UI (ui.app) in the `full` profile.
#
# Build context is the PROJECT ROOT (compose sets context: ..), so paths
# here are project-root relative.
FROM python:3.11-slim

WORKDIR /app

# Install system deps (gcc needed by some pinned wheels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY gateway/ ./gateway/
COPY brain/ ./brain/
COPY adapter/ ./adapter/
COPY ui/ ./ui/
COPY schemas/ ./schemas/
COPY wizard/ ./wizard/
COPY scripts/ ./scripts/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY docker/supervisord.gateway.conf ./docker/

ENV PYTHONUNBUFFERED=1

# Default: supervisord runs the gateway AND the routing brain as two
# processes in this one container (plan Issue 9 — brain crash must not
# kill the proxy). Compose overrides with `command:` for the ui service.
CMD ["supervisord", "-c", "docker/supervisord.gateway.conf"]

EXPOSE 4000 4002
