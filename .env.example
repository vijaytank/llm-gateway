# LLM Gateway — Environment Variables
# Copy to .env and fill in. The setup wizard (python wizard/setup.py) generates
# this file for you with a random Postgres password, session secret, and master key.

# ---- Required ----
# Postgres password used by docker-compose services (generated by the wizard)
POSTGRES_PASSWORD=

# ---- Cloud provider API keys (free tiers) ----
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# ---- Connection URLs (wizard sets these; adjust for bare metal) ----
DATABASE_URL=postgresql://llm_gateway:CHANGE_ME@localhost:5432/llm_gateway
REDIS_URL=redis://localhost:6379/0

# ---- Security (plan Issues 12/14) ----
# LiteLLM admin/master key — randomly generated on first setup, >= 32 chars
LITELLM_MASTER_KEY=
# Web UI session signing secret — set a fixed value so sessions survive restarts
SESSION_SECRET=

# ---- Optional ----
# Custom provider API keys are referenced BY NAME in gateway_config.yaml
# (api_key_env field); define the actual values here, e.g.:
# MY_PROVIDER_API_KEY=sk-...
# VLLM_API_KEY=local
